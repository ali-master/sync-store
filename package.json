{
  "name": "usex",
  "version": "0.0.0",
  "private": true,
  "author": {
    "name": "Ali Torki",
    "url": "https://github.com/ali-master",
    "email": "ali_4286@live.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ali-master/sync-store.git"
  },
  "workspaces": [
    "packages/*",
    "apps/*",
    "examples/react-app"
  ],
  "scripts": {
    "build": "turbo run build",
    "build:api": "turbo run build --filter=@usex/api",
    "dev": "turbo run dev",
    "dev:api": "turbo run dev --filter=@usex/api",
    "start:prod": "turbo run start:prod --filter=@usex/api",
    "lint": "turbo run lint",
    "format": "turbo run format",
    "test": "turbo run test",
    "clean": "turbo run clean",
    "db:generate": "bun run --cwd apps/api db:generate",
    "db:push": "bun run --cwd apps/api db:push",
    "db:deploy": "bun run --cwd apps/api db:deploy",
    "db:migrate": "bun run --cwd apps/api db:migrate",
    "db:setup": "bun run --cwd apps/api db:setup",
    "test:types": "turbo run test:types",
    "test:knip": "bun --bun knip",
    "test:knip:fix": "bun --bun knip --fix",
    "depcruise": "bunx --bun depcruise packages --include-only \"^packages/.*/src\" --exclude \"\\.spec\\.ts\" --config --output-type dot | dot -T svg | bun run depcruise-wrap-stream-in-html > dependency-graph.html"
  },
  "dependencies": {
    "@nestjs/cqrs": "^12.1.1",
    "@nestjs/platform-socket.io": "^12.2.0",
    "@nestjs/websockets": "^12.2.0",
    "axios": "^1.20.0",
    "effect": "^4.0.6",
    "socket.io": "^4.8.4"
  },
  "devDependencies": {
    "@swc/core": "1.16.20",
    "@types/node": "^26.6.5",
    "@typescript/typescript6": "^6.0.2",
    "@usex/prune-mod": "^0.0.14",
    "@usex/static-analyzer": "workspace:*",
    "dependency-cruiser": "^18.7.0",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "tsup": "9.0.0",
    "turbo": "^2.11.10",
    "typescript": "^6.0.3",
    "@typescript/native": "npm:typescript@^7.0.2"
  },
  "engines": {
    "bun": ">=1.4.4"
  },
  "resolutions": {
    "@usex/utils": "workspace:*",
    "@usex/tsconfig": "workspace:*",
    "@usex/static-analyzer": "workspace:*"
  },
  "packageManager": "bun@1.4.4"
}
