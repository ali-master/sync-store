{
  "extends": "@usex/tsconfig",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "lib": ["dom", "es2022"],
    "strict": true,
    "strictNullChecks": true,
    "noImplicitThis": false,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "jsx": "react"
  },
  "include": ["src/**/*"],
  "exclude": ["dist", "node_modules", ".turbo"]
}
