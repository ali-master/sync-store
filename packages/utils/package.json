{
  "name": "@usex/utils",
  "version": "0.0.0",
  "private": true,
  "author": {
    "name": "Ali Torki",
    "url": "https://github.com/ali-master",
    "email": "ali_4286@live.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ali-master/sync-store.git",
    "directory": "packages/utils"
  },
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "typings": "dist/index.d.ts",
  "exports": {
    ".": {
      "require": "./dist/index.js",
      "module": "./dist/index.mjs",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.mjs"
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "assets"
  ],
  "directories": {
    "dist": "dist",
    "assets": "assets"
  },
  "scripts": {
    "dev": "bun --bun tsup --watch",
    "start": "bun --watch ./dist/index.js",
    "build": "bun --bun tsup",
    "prepublishOnly": "bun run lint && bun run test",
    "release": "bun run build",
    "postrelease": "standard-version",
    "release:beta": "cross-env CI=true bun run build",
    "postrelease:beta": "standard-version --prerelease beta",
    "test": "bun test --pass-with-no-tests",
    "test:watch": "bun run test --watch",
    "test:ui": "bun run test:watch --ui --coverage.enabled=true",
    "test:bench": "bun run test bench",
    "test:coverage": "bun run test run --coverage",
    "test:debug": "bun --bun vitest --inspect-brk --pool forks --poolOptions.forks.singleFork",
    "test:debug:watch": "bun run test:debug --watch --poolOptions.threads.isolate false",
    "inspect": "node-modules-inspector",
    "test:types": "tsc --noEmit",
    "test:knip": "bun --bun knip",
    "test:knip:fix": "bun --bun knip --fix",
    "format": "bun --bun prettier --write \"**/*.ts\"",
    "lint": "bun --bun eslint \"src/**/*.ts\"",
    "lint:fix": "bun --bun eslint \"src/**/*.ts\" --fix"
  },
  "dependencies": {
    "@nestjs/common": "^12.2.0",
    "@orama/cuid2": "^2.2.3",
    "@supercharge/request-ip": "^1.2.0",
    "@visulima/humanizer": "^4.0.0",
    "decimal.js": "^10.6.0",
    "isbot": "^5.2.2",
    "kill-port": "^2.0.1",
    "nest-winston": "^2.0.0",
    "node-device-detector": "^2.2.7",
    "uncrypto": "^0.1.3",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@types/kill-port": "^2.0.3",
    "@usex/tsconfig": "workspace:*"
  },
  "peerDependencies": {
    "class-transformer": "*",
    "class-validator": "*",
    "effect": "^4.0.6",
    "express": "^5.3.0",
    "fastify": "^5.12.7",
    "ramda": "^0.32.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "packageManager": "bun@1.4.4"
}
