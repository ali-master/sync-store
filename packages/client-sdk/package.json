{
  "name": "@usex/sync-store",
  "version": "0.0.0",
  "description": "A robust and flexible client-side communication layer for data synchronization, supporting both WebSocket and HTTP REST protocols with intelligent fallback mechanisms.",
  "author": {
    "name": "Ali Torki",
    "url": "https://github.com/ali-master",
    "email": "ali_4286@live.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ali-master/sync-store.git",
    "directory": "packages/client-sdk"
  },
  "private": false,
  "license": "Apache-2.0",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.mjs",
      "require": "./dist/react.js"
    },
    "./legacy": {
      "types": "./dist/legacy.d.ts",
      "import": "./dist/legacy.mjs",
      "require": "./dist/legacy.js"
    },
    "./advanced": {
      "types": "./dist/advanced.d.ts",
      "import": "./dist/advanced.mjs",
      "require": "./dist/advanced.js"
    }
  },
  "scripts": {
    "build": "bun --bun tsup",
    "dev": "bun --bun tsup --watch",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "test:types": "tsc --noEmit",
    "lint": "bun --bun eslint \"src/**/*.ts\"",
    "lint:fix": "bun --bun eslint \"src/**/*.ts\" --fix",
    "format": "bun --bun prettier --write \"src/**/*.ts\"",
    "format:check": "bun --bun prettier --check \"src/**/*.ts\"",
    "release": "bun --bun release-it",
    "release:check": "bun run test:types && bun test test/sync.test.ts test/outbox.test.ts && bun run build",
    "prepack": "bun run build"
  },
  "dependencies": {
    "socket.io-client": "^4.8.4"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@usex/tsconfig": "workspace:*",
    "react": "^19.3.1",
    "release-it": "^21.1.2",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  },
  "packageManager": "bun@1.4.4",
  "peerDependencies": {
    "react": "^19.3.1"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
