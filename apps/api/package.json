{
  "name": "@usex/api",
  "version": "1.0.0",
  "description": "Sync Store API service",
  "private": true,
  "author": {
    "name": "Ali Torki",
    "url": "https://github.com/ali-master",
    "email": "ali_4286@live.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ali-master/sync-store.git",
    "directory": "apps/api"
  },
  "engines": {
    "bun": ">=1.4.4"
  },
  "license": "Apache-2.0",
  "scripts": {
    "admin:key": "bun prisma/admin-key.ts",
    "build": "bun run --cwd ../dashboard build && bun --bun nest build --builder swc --no-type-check",
    "start": "bun run build && bun run start:prod",
    "dev": "bun --bun nest start --watch --exec bun --env-file .env.local",
    "start:debug": "bun --bun nest start --watch --exec 'bun --inspect' --env-file .env.local",
    "start:prod": "bun --tsconfig-override tsconfig.runtime.json dist/main.js",
    "test:types": "tsc --noEmit",
    "test:knip": "bun --bun knip",
    "test:knip:fix": "bun --bun knip --fix",
    "format": "bun --bun prettier --write \"**/*.ts\"",
    "lint": "bun --bun eslint \"**/*.ts\"",
    "lint:fix": "bun --bun eslint \"**/*.ts\" --fix",
    "test": "bun test test/unit",
    "test:watch": "bun test --watch test/unit",
    "test:cov": "bun test --coverage test/unit",
    "test:e2e": "bun test test/integration",
    "db:deploy": "bun --bun prisma db migrate",
    "db:migrate": "bun --bun prisma migration plan",
    "db:setup": "bun run db:generate && bun run db:deploy",
    "db:generate": "bun --bun prisma contract emit",
    "db:push": "bun --bun prisma db update",
    "postinstall": "bun run db:generate"
  },
  "dependencies": {
    "@fastify/compress": "^9.2.2",
    "@fastify/static": "^10.1.7",
    "@fastify/view": "^12.0.1",
    "@maxmind/geoip2-node": "^7.1.0",
    "@nestjs/common": "^12.2.0",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.2.0",
    "@nestjs/cqrs": "^12.1.1",
    "@nestjs/event-emitter": "^12.0.1",
    "@nestjs/jwt": "^12.0.3",
    "@nestjs/passport": "^12.0.0",
    "@nestjs/platform-express": "^12.2.0",
    "@nestjs/platform-fastify": "^12.2.0",
    "@nestjs/platform-socket.io": "^12.2.0",
    "@nestjs/schedule": "^12.0.2",
    "@nestjs/swagger": "^12.0.4",
    "@nestjs/throttler": "^6.7.1",
    "@nestjs/websockets": "^12.2.0",
    "@prisma/orm-mongo": "8.0.0-rc.20",
    "@socket.io/redis-streams-adapter": "^0.3.1",
    "@usex/utils": "workspace:*",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "date-fns": "^4.4.0",
    "dotenv": "^18.0.9",
    "fastify": "^5.12.7",
    "helmet": "^8.3.0",
    "joi": "^18.3.0",
    "mongodb": "^7.7.0",
    "nestjs-cls": "^7.0.1",
    "passport": "^0.7.0",
    "passport-headerapikey": "^1.2.2",
    "passport-jwt": "^4.0.1",
    "prisma": "8.0.0-rc.27",
    "ramda": "^0.32.0",
    "redis": "^6.3.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.4",
    "tiny-lru": "^13.1.1",
    "uncrypto": "^0.1.3"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.10",
    "@nestjs/schematics": "^12.0.10",
    "@nestjs/testing": "^12.2.0",
    "@swc/cli": "^0.8.1",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/passport-jwt": "^4.0.1",
    "@types/ramda": "^0.32.0",
    "@types/supertest": "^7.2.1",
    "@usex/dashboard": "workspace:*",
    "@usex/tsconfig": "workspace:*",
    "@vitest/coverage-istanbul": "^5.0.5",
    "dotenv-expand": "^1000.0.0",
    "knip": "^6.43.0",
    "socket.io-client": "4.8.4",
    "supertest": "^7.3.1",
    "tasuku": "^2.3.0",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  },
  "resolutions": {
    "fastify": "^5",
    "@fastify/middie": "^9",
    "@fastify/cors": "^10"
  },
  "packageManager": "bun@1.4.4"
}
