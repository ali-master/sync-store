# App settings
PORT=3000
NODE_ENV=development
API_URL=http://localhost:3000/api

# Database connection
HISTORY_RETENTION_DAYS=30
DATABASE_URL="mongodb://sync_store:CHANGE_ME@127.0.0.1:27017/sync_store?authSource=admin"

# Set the same Redis URL and prefix on every replica; omit REDIS_URL for a single process.
# Example: redis://localhost:6379
REDIS_URL=
SOCKET_IO_PREFIX=sync-store

# Security settings
JWT_SECRET=your_jwt_secret_key_should_be_long_and_secure
JWT_EXPIRES_IN=7d
JWT_ACCESS_TOKEN_EXPIRATION=15m
JWT_REFRESH_TOKEN_EXPIRATION=7d
API_TOKEN_PREFIX=sv_
ENCRYPTION_KEY=your_encryption_key_for_sensitive_data

# Dashboard single sign-on (OpenID Connect). Leave SSO_ISSUER empty to keep SSO off.
# Register SSO_REDIRECT_URI with your identity provider exactly as written here.
SSO_ISSUER=
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
SSO_REDIRECT_URI=http://localhost:3000/api/v1/sso/callback
SSO_PROVIDER_NAME=
# At least one allow-list is required: only these people may administer the installation.
SSO_ALLOWED_EMAILS=
SSO_ALLOWED_DOMAINS=
SSO_SESSION_MINUTES=480

# Prometheus metrics: bearer token for GET /metrics. Leave empty to allow only admin API keys.
# Generate a long random value, e.g. `openssl rand -hex 32`.
METRICS_TOKEN=

# CORS settings
# Comma-separated IPs/CIDRs of directly connected TLS proxies. Empty trusts none.
TRUSTED_PROXY_CIDRS=
# Exact browser origins; * allows public SDK access without browser credentials.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4000,http://localhost:5173

# Rate limiting
RATE_LIMIT_WINDOW=15m
RATE_LIMIT_MAX=100
RATE_LIMIT_STANDARD_TIER=1000
RATE_LIMIT_PREMIUM_TIER=5000

# Logging settings
LOG_LEVEL=info
LOG_FORMAT=json
LOG_SILENT=false
LOG_COLORIZE=
