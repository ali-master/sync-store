# App settings
PORT=3000
NODE_ENV=development
API_URL=http://localhost:3000/api

# Database connection
DATABASE_URL="mongodb://sync_store:CHANGE_ME@127.0.0.1:27017/sync_store?authSource=admin"

# Set the same Redis URL and prefix on every replica; omit REDIS_URL for a single process.
# Example: redis://localhost:6379
REDIS_URL=
SOCKET_IO_PREFIX=sync-store

# Security settings
JWT_SECRET=your_jwt_secret_key_should_be_long_and_secure
JWT_EXPIRES_IN=7d
JWT_ACCESS_TOKEN_EXPIRATION=15m
JWT_REFRESH_TOKEN_EXPIRATION=7d
API_TOKEN_PREFIX=sv_
ENCRYPTION_KEY=your_encryption_key_for_sensitive_data

# CORS settings
# Comma-separated IPs/CIDRs of directly connected TLS proxies. Empty trusts none.
TRUSTED_PROXY_CIDRS=
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# Rate limiting
RATE_LIMIT_WINDOW=15m
RATE_LIMIT_MAX=100
RATE_LIMIT_STANDARD_TIER=1000
RATE_LIMIT_PREMIUM_TIER=5000

# Logging settings
LOG_LEVEL=info
LOG_FORMAT=json
LOG_SILENT=false
LOG_COLORIZE=
